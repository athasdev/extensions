        ]
      },
      {
        "id": "less",
        "extensions": [
          ".less"
        ],
        "aliases": [
          "Less"
        ]
      }
    ],
    "capabilities": {
      "lsp": {
        "name": "vscode-css-language-server",
        "runtime": "bun",
        "package": "vscode-langservers-extracted",
        "args": [
          "--stdio"
        ]
      },
      "formatter": {
        "name": "prettier",
        "runtime": "bun",
        "package": "prettier",
        "args": [
          "--stdin-filepath",
          "${file}"
        ]
      }
    }
  },
